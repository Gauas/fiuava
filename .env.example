# URL Web App nhận được sau khi Deploy Google Apps Script.
# Phải kết thúc bằng /exec, không dùng URL /dev.
VITE_GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Chuỗi kiểm tra tùy chọn. Giá trị này cũng phải được đặt trong
# Project Settings > Script properties với key FIUAVA_FORM_TOKEN.
# Lưu ý: biến VITE_ được đưa vào bundle trình duyệt, không phải secret tuyệt đối.
VITE_GOOGLE_SHEETS_TOKEN=replace-with-a-random-validation-token

